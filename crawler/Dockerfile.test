# Build context is the repo ROOT, like crawler/Dockerfile: db.py resolves
# schema.sql relative to the package, and test_bootstrap exercises that path.
FROM python:3.13-slim
WORKDIR /app

COPY crawler/requirements.txt crawler/requirements.txt
RUN pip install --no-cache-dir -r crawler/requirements.txt pytest

COPY crawler/stockroom_crawler crawler/stockroom_crawler
COPY crawler/pyproject.toml crawler/pyproject.toml
COPY crawler/tests crawler/tests
COPY backend-ops/schema.sql backend-ops/schema.sql

WORKDIR /app/crawler
ENV PYTEST_ADDOPTS="-o cache_dir=/tmp/pytest-cache"
CMD ["python", "-m", "pytest", "-q"]
