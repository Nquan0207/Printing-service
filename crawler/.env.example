# Postgres (docker compose up -d)
STOCKROOM_DATABASE_URL=postgresql://raksul:raksul_password@127.0.0.1:5432/stockroom

# MinIO object storage for product images
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=stockroom-media
MINIO_SECURE=false

# Crawl budget
CRAWL_MAX_PRODUCTS=150
# How many of the 16 top-level categories to use (from the top of the list)
CRAWL_MAX_CATEGORIES=10
# Optional: pick exact categories instead, comma-separated. Overrides the count's selection.
# CRAWL_CATEGORIES=store_supplies,daily_life_goods,drinks_food
CRAWL_SIZES_PER_PRODUCT=3
CRAWL_MAX_IMAGES=3
CRAWL_REQUEST_DELAY=1.25
