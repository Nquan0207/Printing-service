# Optional: Compose runs without copying this file. All service URLs are internal.
CRAWL_MAX_PRODUCTS=70
CRAWL_MAX_CATEGORIES=8
CRAWL_CATEGORIES=
CRAWL_SIZES_PER_PRODUCT=3
CRAWL_MAX_IMAGES=3
CRAWL_REQUEST_DELAY=1.25
OLLAMA_MODEL=qwen3:8b
# Leave unset to use an Ollama on the host. For an all-Docker stack:
#   OLLAMA_URL=http://ollama:11434   (with --profile docker-ollama)
OLLAMA_URL=
OLLAMA_TIMEOUT_SECONDS=600
CHAT_SESSION_TTL_SECONDS=86400
SHOP_ENABLED=true
STOCKROOM_LOG_LEVEL=info
STOCKROOM_ADMIN_EMAILS=admin@stockroom.local
STOCKROOM_ADMIN_EMAIL=admin@stockroom.local
# Browser-facing ports; container ports and internal URLs stay fixed.
API_HOST_PORT=8080
WEB_HOST_PORT=3000
MCP_HOST_PORT=3001
CHAT_HOST_PORT=3002
SHOPPING_MCP_HOST_PORT=3003
POSTGRES_HOST_PORT=5432
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
