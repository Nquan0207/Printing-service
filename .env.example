# Host-side crawler connection. Docker services use their own internal URLs.
STOCKROOM_DATABASE_URL=postgresql://raksul:raksul_password@127.0.0.1:5432/stockroom
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=stockroom-media
MINIO_SECURE=false

CRAWL_MAX_PRODUCTS=70
CRAWL_MAX_CATEGORIES=8
CRAWL_SIZES_PER_PRODUCT=3
CRAWL_MAX_IMAGES=3
CRAWL_REQUEST_DELAY=1.25

STOCKROOM_API_URL=http://127.0.0.1:8080
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_TRANSPORT=stdio

# Local Ollama shopping chat. The chat host binds loopback only.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
CHAT_HOST=127.0.0.1
CHAT_PORT=3000
CHAT_SESSION_TTL_SECONDS=86400
