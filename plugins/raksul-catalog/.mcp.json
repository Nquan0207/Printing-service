{
  "mcpServers": {
    "raksul_catalog": {
      "command": "docker",
      "args": [
        "exec", "-i", "stockroom-shopping-mcp",
        "python", "-m", "app.mcp_server.server"
      ],
      "enabled": true,
      "startup_timeout_sec": 30
    },
    "raksul_ops": {
      "command": "docker",
      "args": [
        "exec", "-i", "stockroom-admin-mcp",
        "python", "-m", "stockroom_ops.server",
        "--transport", "stdio"
      ],
      "enabled": true,
      "startup_timeout_sec": 30
    }
  }
}